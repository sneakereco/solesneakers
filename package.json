{
  "name": "solesneakers",
  "engines": {
    "node": "^24.14.1"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test:jest": "npm run test:jest:unit && npm run test:jest:integration",
    "test:jest:unit": "jest --config jest.config.ts",
    "test:jest:integration": "jest --config jest.integration.config.ts",
    "test:analytics:browser": "node tests/browser/admin-analytics.mjs",
    "test:analytics:operations": "node --test tests/database/admin-analytics-migration-order.test.mjs tests/operations/admin-analytics-provision.test.mjs tests/operations/admin-analytics-observers.test.mjs",
    "analytics:provision": "node scripts/provision-admin-analytics.mjs",
    "analytics:observe": "node scripts/run-admin-analytics-observers.mjs",
    "test:measurement:browser": "node tests/browser/measurement-trigger-sites.mjs && node tests/browser/measurement-sdk-boundary.mjs",
    "test:e2e": "node tests/browser/payment-methods.mjs && node tests/browser/checkout-ui.mjs && node tests/browser/shipping-validation.mjs && node tests/browser/checkout-success.mjs && node tests/browser/checkout-progress.mjs && node tests/browser/admin-transaction-detail.mjs && node tests/browser/admin-button-contrast.mjs && node tests/browser/shipping-settings-modal.mjs && node tests/browser/store-menu.mjs && node tests/browser/home-featured-items.mjs && node tests/browser/home-clothing.mjs && node tests/browser/home-categories.mjs && node tests/browser/storefront-branding.mjs && node tests/browser/auth-lock-navigation.mjs",
    "test:ux:browser": "node tests/browser/ux-journeys.mjs",
    "test:rls": "tsx ./tests/rls/rls-check.ts",
    "test:specialty:browser": "node tests/browser/specialty-claims.mjs",
    "test:specialty:load": "node --import tsx scripts/load/specialty-claims.mjs",
    "test:specialty:database": "node --test --test-concurrency=1 tests/database/specialty-claims-schema.test.mjs tests/database/specialty-claims-concurrency.test.mjs tests/database/specialty-claims-admin.test.mjs tests/database/specialty-claims-backpressure.test.mjs tests/database/specialty-claims-observation.test.mjs tests/database/specialty-browser-environment.test.mjs tests/database/specialty-local-redis.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "doppler run -- next dev",
    "build": "doppler run -- next build",
    "start": "doppler run -- next start",
    "gen:types": "npx supabase gen types typescript --local --schema public > src/types/db/database.types.ts",
    "test:store-lock:database": "node --test --test-concurrency=1 tests/database/site-lock-registration.test.mjs",
    "test:reseller-orders:database": "node --test --test-concurrency=1 tests/database/reseller-order-notifications.test.mjs"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@daypicker/react": "10.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.81.1",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.35.6",
    "botid": "^1.5.11",
    "browser-image-compression": "^2.0.2",
    "jose": "^6.1.2",
    "lucide-react": "^0.562.0",
    "next": "^16.3.3",
    "nodemailer": "^9.1.1",
    "posthog-js": "1.433.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shippo": "^2.15.0",
    "square": "^45.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@next/env": "16.3.3",
    "@playwright/test": "^1.56.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.8",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.22",
    "esbuild": "~0.25.12",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.2.0",
    "pg": "^8.16.3",
    "postcss": "^8.5.26",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "supabase": "2.117.0",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "private": true
}
